if(NOT DEFINED LEVIOSAM2 OR NOT DEFINED TEST_TMP_DIR)
    message(FATAL_ERROR "LEVIOSAM2 and TEST_TMP_DIR are required")
endif()
find_program(PYTHON_EXECUTABLE NAMES python3 REQUIRED)
file(REMOVE_RECURSE "${TEST_TMP_DIR}")
execute_process(COMMAND "${PYTHON_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/bed_liftover_cli_test.py"
    "${LEVIOSAM2}" "${TEST_TMP_DIR}"
    RESULT_VARIABLE RESULT OUTPUT_VARIABLE STDOUT ERROR_VARIABLE STDERR)
if(NOT RESULT EQUAL 0)
    message(FATAL_ERROR "BED CLI regression failed (${RESULT}):\n${STDOUT}\n${STDERR}")
endif()
