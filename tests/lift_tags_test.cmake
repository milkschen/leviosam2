if(NOT DEFINED LEVIOSAM2 OR NOT DEFINED TEST_TMP_DIR)
    message(FATAL_ERROR "LEVIOSAM2 and TEST_TMP_DIR are required")
endif()
file(REMOVE_RECURSE "${TEST_TMP_DIR}")
file(MAKE_DIRECTORY "${TEST_TMP_DIR}")
file(WRITE "${TEST_TMP_DIR}/tiny.chain"
    "chain 1 src 1000 + 100 200 dst 1000 + 300 400 1\n100\n\n"
    "chain 1 revsrc 1000 + 100 200 revdst 1000 - 600 700 2\n100\n")
file(WRITE "${TEST_TMP_DIR}/target.fai" "dst\t1000\nrevdst\t1000\n")
string(REPEAT "A" 1000 BASES)
file(WRITE "${TEST_TMP_DIR}/target.fa" ">dst\n${BASES}\n>revdst\n${BASES}\n")
file(WRITE "${TEST_TMP_DIR}/input.sam" "@HD\tVN:1.6\n@SQ\tSN:src\tLN:1000\n@SQ\tSN:revsrc\tLN:1000\n")
set(TAGS "\tSA:Z:src,111,+,10M,60,0;\tXA:Z:src,+111,10M,0;\tMC:Z:10M\tMD:Z:10\tNM:i:0\tRG:Z:sample")
foreach(SPEC "primary;0;src;111" "secondary;256;src;111" "supplementary;2048;src;111" "reverse;0;revsrc;111" "unliftable;0;src;501" "placed-unmapped;4;src;111")
    list(GET SPEC 0 NAME)
    list(GET SPEC 1 FLAG)
    list(GET SPEC 2 REF)
    list(GET SPEC 3 POS)
    file(APPEND "${TEST_TMP_DIR}/input.sam" "${NAME}\t${FLAG}\t${REF}\t${POS}\t60\t10M\t*\t0\t0\tAAAAAAAAAA\tIIIIIIIIII${TAGS}\n")
endforeach()
file(APPEND "${TEST_TMP_DIR}/input.sam" "unmapped\t4\t*\t0\t0\t*\t*\t0\t0\tAAAAAAAAAA\tIIIIIIIIII${TAGS}\n")
execute_process(COMMAND "${LEVIOSAM2}" index -c "${TEST_TMP_DIR}/tiny.chain"
    -F "${TEST_TMP_DIR}/target.fai" -p "${TEST_TMP_DIR}/tiny"
    RESULT_VARIABLE RESULT ERROR_VARIABLE STDERR)
if(NOT RESULT EQUAL 0)
    message(FATAL_ERROR "index failed: ${STDERR}")
endif()
foreach(MODE direct indexed)
    if(MODE STREQUAL "direct")
        set(MAP_ARGS -c "${TEST_TMP_DIR}/tiny.chain" -F "${TEST_TMP_DIR}/target.fai")
    else()
        set(MAP_ARGS -C "${TEST_TMP_DIR}/tiny.clft")
    endif()
    foreach(MD plain recompute)
        set(MD_ARGS)
        if(MD STREQUAL "recompute")
            set(MD_ARGS -m -f "${TEST_TMP_DIR}/target.fa")
        endif()
        set(PREFIX "${TEST_TMP_DIR}/${MODE}-${MD}")
        execute_process(COMMAND "${LEVIOSAM2}" lift ${MAP_ARGS} ${MD_ARGS}
            -a "${TEST_TMP_DIR}/input.sam" -p "${PREFIX}" -O sam
            RESULT_VARIABLE RESULT ERROR_VARIABLE STDERR)
        if(NOT RESULT EQUAL 0)
            message(FATAL_ERROR "${MODE}/${MD} failed (${RESULT}): ${STDERR}")
        endif()
        file(STRINGS "${PREFIX}.sam" LINES)
        set(COUNT 0)
        foreach(LINE IN LISTS LINES)
            if(LINE MATCHES "^@")
                continue()
            endif()
            math(EXPR COUNT "${COUNT} + 1")
            if(LINE MATCHES "\t(SA|XA|MC):" OR NOT LINE MATCHES "\tRG:Z:sample")
                message(FATAL_ERROR "${MODE}/${MD} incorrect tag policy: ${LINE}")
            endif()
            if(MD STREQUAL "plain" AND LINE MATCHES "\t(MD|NM):")
                message(FATAL_ERROR "stale edit tags retained: ${LINE}")
            endif()
            if(LINE MATCHES "^(unmapped|placed-unmapped|unliftable)\t" AND
               LINE MATCHES "\t(MD|NM):")
                message(FATAL_ERROR "unmapped record retained edit tags: ${LINE}")
            endif()
            if(MD STREQUAL "recompute" AND LINE MATCHES "^primary\t" AND
               (NOT LINE MATCHES "\tMD:Z:10" OR NOT LINE MATCHES "\tNM:i:0"))
                message(FATAL_ERROR "target edit tags not regenerated: ${LINE}")
            endif()
        endforeach()
        if(NOT COUNT EQUAL 7)
            message(FATAL_ERROR "expected seven output records, got ${COUNT}")
        endif()
        file(READ "${PREFIX}.sam" OUTPUT)
        if(NOT OUTPUT MATCHES "reverse\t16\trevdst\t381\t60\t10M")
            message(FATAL_ERROR "reverse lift did not exercise target coordinates: ${OUTPUT}")
        endif()
    endforeach()
endforeach()
