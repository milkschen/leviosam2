if(NOT DEFINED LEVIOSAM2 OR NOT DEFINED TEST_TMP_DIR)
    message(FATAL_ERROR "LEVIOSAM2 and TEST_TMP_DIR are required")
endif()
file(REMOVE_RECURSE "${TEST_TMP_DIR}")
file(MAKE_DIRECTORY "${TEST_TMP_DIR}")
set(HEADER "@HD\tVN:1.6\tSO:queryname\n@SQ\tSN:chr1\tLN:100\n")
set(SINGLE "a\t0\tchr1\t1\t60\t1M\t*\t0\t0\tA\tI\tNM:i:0\n")
set(EXTRA "b\t0\tchr1\t2\t60\t1M\t*\t0\t0\tA\tI\tNM:i:0\n")
set(FIRST "a\t65\tchr1\t1\t60\t1M\t=\t2\t2\tA\tI\tNM:i:0\n")
set(SECOND "a\t129\tchr1\t2\t60\t1M\t=\t1\t-2\tA\tI\tNM:i:0\n")
set(SECONDARY "a\t256\tchr1\t3\t20\t1M\t*\t0\t0\tA\tI\tNM:i:1\n")
set(SUPPLEMENTARY "a\t2048\tchr1\t4\t20\t1M\t*\t0\t0\tA\tI\tNM:i:1\n")
set(BAD "broken\t0\tchr1\t1\t60\t10M\t*\t0\t0\tA\tI\n")
function(check_case NAME LEFT RIGHT PAIRED EXPECT_ERROR EXPECT_COUNT)
    file(WRITE "${TEST_TMP_DIR}/left.sam" "${HEADER}${LEFT}")
    file(WRITE "${TEST_TMP_DIR}/right.sam" "${HEADER}${RIGHT}")
    set(MODE)
    if(PAIRED)
        set(MODE -m)
    endif()
    execute_process(COMMAND "${LEVIOSAM2}" reconcile ${MODE}
        -s "left:${TEST_TMP_DIR}/left.sam" -s "right:${TEST_TMP_DIR}/right.sam"
        -o "${TEST_TMP_DIR}/out.sam"
        RESULT_VARIABLE RESULT ERROR_VARIABLE STDERR OUTPUT_VARIABLE STDOUT)
    if(EXPECT_ERROR)
        if(RESULT EQUAL 0 OR NOT STDERR MATCHES "${EXPECT_ERROR}")
            message(FATAL_ERROR "${NAME}: expected ${EXPECT_ERROR}; result ${RESULT}: ${STDERR}")
        endif()
    else()
        if(NOT RESULT EQUAL 0)
            message(FATAL_ERROR "${NAME}: failed (${RESULT}): ${STDERR}")
        endif()
        file(STRINGS "${TEST_TMP_DIR}/out.sam" RECORDS REGEX "^[^@]")
        list(LENGTH RECORDS COUNT)
        if(NOT COUNT EQUAL EXPECT_COUNT)
            message(FATAL_ERROR "${NAME}: expected ${EXPECT_COUNT} output records, got ${COUNT}")
        endif()
        if(NOT STDERR MATCHES "Processed 1 (pairs of reads|reads)" AND EXPECT_COUNT GREATER 0)
            message(FATAL_ERROR "${NAME}: incorrect processed count: ${STDERR}")
        endif()
    endif()
endfunction()
check_case(single_equal "${SINGLE}" "${SINGLE}" FALSE "" 1)
check_case(empty "" "" FALSE "" 0)
check_case(single_left_short "${SINGLE}" "${SINGLE}${EXTRA}" FALSE "Input lengths mismatch" 0)
check_case(single_right_short "${SINGLE}${EXTRA}" "${SINGLE}" FALSE "Input lengths mismatch" 0)
check_case(single_empty_left "" "${SINGLE}" FALSE "Input lengths mismatch" 0)
check_case(single_empty_right "${SINGLE}" "" FALSE "Input lengths mismatch" 0)
check_case(single_nonprimary "${SECONDARY}${SINGLE}${SUPPLEMENTARY}" "${SINGLE}" FALSE "" 1)
check_case(single_malformed "${SINGLE}${BAD}" "${SINGLE}" FALSE "Failed to read alignment" 0)
check_case(single_malformed_other "${SINGLE}" "${SINGLE}${BAD}" FALSE "Failed to read alignment" 0)
check_case(pair_equal "${FIRST}${SECOND}" "${FIRST}${SECOND}" TRUE "" 2)
check_case(pair_nonprimary "${SECONDARY}${FIRST}${SUPPLEMENTARY}${SECOND}${SECONDARY}" "${FIRST}${SECOND}${SUPPLEMENTARY}" TRUE "" 2)
check_case(pair_left_short "" "${FIRST}${SECOND}" TRUE "Input lengths mismatch" 0)
check_case(pair_right_short "${FIRST}${SECOND}" "" TRUE "Input lengths mismatch" 0)
check_case(pair_incomplete_left "${FIRST}" "${FIRST}${SECOND}" TRUE "Incomplete pair" 0)
check_case(pair_incomplete_right "${FIRST}${SECOND}" "${FIRST}${SECOND}${FIRST}${SUPPLEMENTARY}" TRUE "Incomplete pair" 0)
check_case(pair_malformed "${FIRST}${BAD}" "${FIRST}${SECOND}" TRUE "Failed to read alignment" 0)
check_case(pair_empty "" "" TRUE "" 0)
check_case(pair_extra_left "${FIRST}${SECOND}${FIRST}${SECOND}" "${FIRST}${SECOND}" TRUE "Input lengths mismatch" 0)
check_case(pair_extra_right "${FIRST}${SECOND}" "${FIRST}${SECOND}${FIRST}${SECOND}" TRUE "Input lengths mismatch" 0)
check_case(pair_malformed_after_eof "${FIRST}${SECOND}" "${FIRST}${SECOND}${BAD}" TRUE "Failed to read alignment" 0)
string(REPLACE "a\t129" "b\t129" WRONG_MATE "${SECOND}")
check_case(pair_name_mismatch "${FIRST}${WRONG_MATE}" "${FIRST}${SECOND}" TRUE "sorted by read name" 0)
